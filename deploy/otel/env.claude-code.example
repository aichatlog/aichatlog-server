# Enable Claude Code's native OpenTelemetry metrics and point them at the
# collector in this stack. Export these in the shell (or machine) that runs
# Claude Code — NOT in the docker-compose stack. Then start `claude`.
#
#   export $(grep -v '^#' env.claude-code.example | xargs)   # quick local test
#
# Per-server: set OTEL_RESOURCE_ATTRIBUTES so each host is distinguishable.

CLAUDE_CODE_ENABLE_TELEMETRY=1
OTEL_METRICS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Lower interval for quicker feedback while testing (default 60000ms).
OTEL_METRIC_EXPORT_INTERVAL=10000
# Tag this host so you can group by it in Grafana (host.name becomes a label).
OTEL_RESOURCE_ATTRIBUTES=host.name=my-server-1
